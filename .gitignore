# Dependencies
node_modules/
vendor/

# Build output
.next/
out/
dist/
build/

# Env and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Laravel: apps live under services/, so these must match at any depth.
# The trailing /* ignores contents but keeps each dir's tracked .gitignore
# stub, so the directories still exist on a fresh clone.
**/storage/*.key
**/storage/pail
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/testing/*
**/storage/framework/views/*
**/storage/logs/*
**/bootstrap/cache/*
**/public/storage
**/public/hot
!**/.gitignore

# Local data volumes
data/
*.sqlite
*.sqlite3

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
